{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      // A PostgreSQL major upgrade replaces the clusters, so the images stay on 18 until then.
      description: "Keep PostgreSQL images on major version 18",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "docker.io/prodrigestivill/postgres-backup-local",
        "ghcr.io/cloudnative-pg/postgresql",
        "ghcr.io/home-operations/postgres-init",
      ],
      allowedVersions: "/^18(?:[.-]|$)/",
    },
    {
      // Karakeep tests Meilisearch at the version in its docker/docker-compose.yml, and a newer
      // version can break it, so the cap follows that file.
      description: "Cap Meilisearch at the version that Karakeep tests",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/getmeili/meilisearch"],
      allowedVersions: "<=1.55.0",
    },
    {
      // RustFS also publishes -preview and -glibc tags, which the regex excludes.
      description: "Offer only stable RustFS releases",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/rustfs/rustfs"],
      versioning: "semver",
      respectLatest: false,
      allowedVersions: "/^\\d+\\.\\d+\\.\\d+$/",
    },
  ],
}
